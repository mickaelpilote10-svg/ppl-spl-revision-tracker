{
  "name": "ppl-spl-revision-tracker-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows app wrapper for PPL(A) / SPL Revision Tracker",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "ch.ppltracker.desktop",
    "productName": "PPL SPL Revision Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "assets/app-icon.ico"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PPL SPL Revision Tracker"
    },
    "artifactName": "PPL-SPL-Revision-Tracker-${version}-Setup.${ext}"
  }
}
